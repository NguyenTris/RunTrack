<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RunTrack">

        <!-- Initial Splash / Intro Activity -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication / Login Activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Registration Activity -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Login Success / Verified Session Activity -->
        <activity
            android:name=".AuthSuccessActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dashboard / Home Activity -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile & Diagnostics Activity -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Leaderboard Activity -->
        <activity
            android:name=".LeaderboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- GPS Art Creator Activity -->
        <activity
            android:name=".GpsArtActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Live Telemetry Tracking Activity -->
        <activity
            android:name=".TrackingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Post-Run Summary Activity -->
        <activity
            android:name=".RunSummaryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Progress & Activity Screen Activity -->
        <activity
            android:name=".ProgressActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Run Tracking Dashboard Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Messages / Chat Activity -->
        <activity
            android:name=".chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Chat Detail / Active Conversation Activity -->
        <activity
            android:name=".chat.ChatDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Search Activity -->
        <activity
            android:name=".search.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Search Detail / Profile & Club View Activity -->
        <activity
            android:name=".search.SearchDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- HUD Settings & Peripherals Host Activity -->
        <activity
            android:name=".HudSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- HUD Notifications Center Activity -->
        <activity
            android:name=".NotificationCenterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
