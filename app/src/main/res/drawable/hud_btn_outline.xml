<?xml version="1.0" encoding="utf-8"?>
<!-- Diagnostic / Outline Action Button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_surface_card" />
            <stroke android:width="@dimen/hud_border_thin" android:color="@color/hud_primary" />
            <corners android:radius="@dimen/hud_radius_zero" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="@dimen/hud_border_thin" android:color="@color/hud_border_structural" />
            <corners android:radius="@dimen/hud_radius_zero" />
        </shape>
    </item>
</selector>
