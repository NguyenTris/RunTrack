<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Track -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/surface_border" />
        </shape>
    </item>
    <!-- Progress Indicator with Orange-to-Cyan Gradient -->
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <gradient
                    android:angle="0"
                    android:endColor="@color/electric_cyan"
                    android:startColor="@color/kinetic_orange"
                    android:type="linear" />
            </shape>
        </scale>
    </item>
</layer-list>
