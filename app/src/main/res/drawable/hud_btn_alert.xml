<?xml version="1.0" encoding="utf-8"?>
<!-- Alert Action Button State Selector (Neon Orange) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_canvas" />
            <stroke android:width="@dimen/hud_border_thick" android:color="@color/hud_alert" />
            <corners android:radius="@dimen/hud_radius_zero" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hud_alert" />
            <corners android:radius="@dimen/hud_radius_zero" />
        </shape>
    </item>
</selector>
