<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_stroke" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
        </shape>
    </item>
    <item
        android:width="4dp"
        android:gravity="start">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_green" />
        </shape>
    </item>
</layer-list>
