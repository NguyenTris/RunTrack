<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Orange Border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kinetic_orange" />
        </shape>
    </item>
    <!-- Dark Card Background Surface -->
    <item
        android:bottom="1dp"
        android:left="4dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
        </shape>
    </item>
</layer-list>
