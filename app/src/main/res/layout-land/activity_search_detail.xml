<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_search_detail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    tools:context=".search.SearchDetailActivity">

    <!-- Top Bar -->
    <ImageView
        android:id="@+id/btn_detail_back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_back"
        android:padding="4dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="@+id/tv_detail_top_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_detail_top_title"
        app:tint="#F4C073" />

    <TextView
        android:id="@+id/tv_detail_top_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F4C073"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_detail_back"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Hồ sơ Runner" />

    <View
        android:id="@+id/detail_top_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#22262B"
        app:layout_constraintTop_toBottomOf="@+id/tv_detail_top_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/detail_top_divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Left Side: Profile Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#1A1D20"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#262B30"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_profile_avatar"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:contentDescription="Avatar"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/CircleAvatar"
                            tools:src="@drawable/ic_person_chat" />

                        <ImageView
                            android:id="@+id/iv_profile_group_icon"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:background="@drawable/bg_chat_avatar_group"
                            android:contentDescription="CLB Icon"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_group_chat"
                            android:visibility="gone" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Đức Huy" />

                    <TextView
                        android:id="@+id/tv_profile_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#8E8E93"
                        android:textSize="12sp"
                        tools:text="128 KM tháng này • Hà Nội" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Right Side: Friend/Club Details -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3">

                <!-- FRIEND SECTION -->
                <LinearLayout
                    android:id="@+id/layout_friend_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_profile_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="TỔNG CỰ LY"
                                android:textColor="#8E8E93"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/tv_stat_distance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="342 KM"
                                android:textColor="#F4C073"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_profile_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="PACE TB"
                                android:textColor="#8E8E93"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/tv_stat_pace"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="5'12&quot;"
                                android:textColor="#F4C073"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_profile_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="SỐ BUỔI CHẠY"
                                android:textColor="#8E8E93"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/tv_stat_runs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="48 buổi"
                                android:textColor="#F4C073"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_friend_add"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="Kết bạn"
                            android:textColor="#121212"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="#F4C073"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_friend_chat"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Nhắn tin"
                            android:textColor="#F4C073"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"
                            app:strokeColor="#F4C073"
                            app:strokeWidth="1.5dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- CLUB SECTION -->
                <LinearLayout
                    android:id="@+id/layout_club_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#1A1D20"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#262B30"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="TỔNG CỰ LY ĐỘI (TUẦN NÀY)"
                                android:textColor="#8E8E93"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/tv_club_total_dist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="1,850 KM"
                                android:textColor="#F4C073"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="8dp"
                                android:background="#262B30" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="LỊCH SINH HOẠT CỐ ĐỊNH"
                                android:textColor="#8E8E93"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/tv_club_schedule"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Thứ 3, Thứ 5 &amp; Chủ Nhật (05:30 AM)"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginVertical="8dp"
                                android:background="#262B30" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="KHU VỰC CHẠY CHÍNH"
                                android:textColor="#8E8E93"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/tv_club_location"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Công viên Thống Nhất • Hà Nội"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_club_join"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="Tham gia CLB"
                        android:textColor="#121212"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="#F4C073"
                        app:cornerRadius="8dp" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
