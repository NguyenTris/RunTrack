<?xml version="1.0" encoding="utf-8"?>
<!-- [SCR-07] HỒ SƠ THỂ CHẤT & SINH TRẮC (BIOMETRIC PROFILE & PHYSICAL METRICS) -->
<!-- Architecture: RelativeLayout (Root) + ScrollView > LinearLayout (Body) + Two-Column Metrics (Weights) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_canvas">

    <!-- PRE-HEADER STRIP -->
    <LinearLayout
        android:id="@+id/telemetryStrip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hud_telemetry_strip_height"
        android:layout_alignParentTop="true"
        android:background="@color/hud_surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hud_space_md"
        android:paddingEnd="@dimen/hud_space_md">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="USER PROFILE // BIOMETRICS"
            android:textColor="@color/hud_text_dim"
            android:textSize="@dimen/hud_text_telemetry_strip" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="BMI: 22.9 NORMAL"
            android:textColor="@color/hud_signal"
            android:textSize="@dimen/hud_text_telemetry_strip" />
    </LinearLayout>

    <!-- TOP APP BAR -->
    <RelativeLayout
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hud_top_bar_height"
        android:layout_below="@id/telemetryStrip"
        android:background="@color/hud_surface"
        android:paddingStart="@dimen/hud_space_md"
        android:paddingEnd="@dimen/hud_space_md">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:text="&lt; HUB"
            android:textColor="@color/hud_primary"
            android:textSize="@dimen/hud_text_body"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:letterSpacing="0.1"
            android:text="HỒ SƠ THỂ CHẤT"
            android:textAllCaps="true"
            android:textColor="@color/hud_text_primary"
            android:textSize="@dimen/hud_text_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/hud_badge_cyan"
            android:fontFamily="monospace"
            android:paddingStart="@dimen/hud_space_xs"
            android:paddingTop="@dimen/hud_space_2xs"
            android:paddingEnd="@dimen/hud_space_xs"
            android:paddingBottom="@dimen/hud_space_2xs"
            android:text="BIO CAL"
            android:textColor="@color/hud_primary"
            android:textSize="@dimen/hud_text_badge" />
    </RelativeLayout>

    <!-- FIXED BOTTOM UPDATE BUTTON -->
    <Button
        android:id="@+id/btnUpdateBiometrics"
        style="@style/HudButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hud_btn_primary_height"
        android:layout_alignParentBottom="true"
        android:layout_margin="@dimen/hud_space_md"
        android:text="CẬP NHẬT CHỈ SỐ THỂ CHẤT" />

    <!-- SCROLLABLE FORM -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnUpdateBiometrics"
        android:layout_below="@id/topAppBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/hud_space_md">

            <!-- TWO-COLUMN AUTO-CALCULATED METRICS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hud_space_lg"
                android:orientation="horizontal">

                <!-- BMI Metric Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/hud_space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/hud_card_container"
                    android:orientation="vertical"
                    android:padding="@dimen/hud_space_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="CHỈ SỐ BMI"
                        android:textColor="@color/hud_text_dim"
                        android:textSize="@dimen/hud_text_caption" />

                    <TextView
                        android:id="@+id/tvBmiVal"
                        style="@style/HudText.DisplayHero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hud_space_xs"
                        android:text="22.9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="CHUẨN THỂ TRẠNG"
                        android:textColor="@color/hud_signal"
                        android:textSize="@dimen/hud_text_caption" />
                </LinearLayout>

                <!-- BMR Metric Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hud_space_xs"
                    android:layout_weight="1"
                    android:background="@drawable/hud_card_container"
                    android:orientation="vertical"
                    android:padding="@dimen/hud_space_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="CHUYỂN HÓA BMR"
                        android:textColor="@color/hud_text_dim"
                        android:textSize="@dimen/hud_text_caption" />

                    <TextView
                        android:id="@+id/tvBmrVal"
                        style="@style/HudText.DisplayHero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hud_space_xs"
                        android:text="1,740" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="KCAL / NGÀY"
                        android:textColor="@color/hud_text_sub"
                        android:textSize="@dimen/hud_text_caption" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/HudText.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hud_space_sm"
                android:text="■ CHỈ SỐ HÌNH THỂ THỰC TẾ" />

            <!-- INPUT 1: WEIGHT (KG) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hud_space_md"
                android:background="@drawable/hud_input_box"
                android:orientation="vertical"
                android:padding="@dimen/hud_space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="CÂN NẶNG HIỆN TẠI (KG)"
                    android:textColor="@color/hud_text_dim"
                    android:textSize="@dimen/hud_text_caption" />

                <EditText
                    android:id="@+id/etWeightKg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hud_space_xs"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:inputType="numberDecimal"
                    android:text="72.5"
                    android:textColor="@color/hud_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- INPUT 2: HEIGHT (CM) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hud_space_md"
                android:background="@drawable/hud_input_box"
                android:orientation="vertical"
                android:padding="@dimen/hud_space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="CHIỀU CAO (CM)"
                    android:textColor="@color/hud_text_dim"
                    android:textSize="@dimen/hud_text_caption" />

                <EditText
                    android:id="@+id/etHeightCm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hud_space_xs"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:inputType="number"
                    android:text="178"
                    android:textColor="@color/hud_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- INPUT 3: AGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hud_space_md"
                android:background="@drawable/hud_input_box"
                android:orientation="vertical"
                android:padding="@dimen/hud_space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="ĐỘ TUỔI SINH HỌC"
                    android:textColor="@color/hud_text_dim"
                    android:textSize="@dimen/hud_text_caption" />

                <EditText
                    android:id="@+id/etAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hud_space_xs"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:inputType="number"
                    android:text="28"
                    android:textColor="@color/hud_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- BIOLOGICAL SEX SELECTOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hud_space_md"
                android:background="@drawable/hud_card_container"
                android:orientation="vertical"
                android:padding="@dimen/hud_space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="GIỚI TÍNH SINH HỌC (TÍNH CALO &amp; MAX HR)"
                    android:textColor="@color/hud_text_dim"
                    android:textSize="@dimen/hud_text_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="@dimen/hud_space_sm"
                    android:background="@color/hud_surface_sub"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSexMale"
                        style="@style/HudButton.Primary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="NAM (MALE)"
                        android:textSize="@dimen/hud_text_caption" />

                    <Button
                        android:id="@+id/btnSexFemale"
                        style="@style/HudButton.Outline"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="NỮ (FEMALE)"
                        android:textSize="@dimen/hud_text_caption" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
