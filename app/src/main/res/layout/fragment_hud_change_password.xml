<?xml version="1.0" encoding="utf-8"?>
<!-- [SCR-SEC-01] ĐỔI MẬT KHẨU (CHANGE PASSWORD) -->
<!-- Aerospace Kinetic HUD Architecture -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_canvas">

    <!-- PRE-HEADER TELEMETRY STRIP (Fixed Top) -->
    <LinearLayout
        android:id="@+id/telemetryStrip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hud_telemetry_strip_height"
        android:layout_alignParentTop="true"
        android:background="@color/hud_surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hud_space_md"
        android:paddingEnd="@dimen/hud_space_md">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:text="&lt; BẢO MẬT"
            android:textColor="@color/hud_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="RT / SEC-01"
            android:textColor="@color/hud_text_dim"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- HEADER BLOCK -->
    <LinearLayout
        android:id="@+id/headerBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/telemetryStrip"
        android:background="@color/hud_surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/hud_space_md"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Đổi mật khẩu"
            android:textColor="@color/hud_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Cập nhật mật khẩu để bảo vệ tài khoản của bạn."
            android:textColor="@color/hud_text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- FIXED BOTTOM ACTION BAR -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/hud_surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/hud_space_md">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_btn_outline"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="HỦY BỎ"
            android:textColor="@color/hud_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSavePassword"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.6"
            android:background="@drawable/hud_bg_bar_orange"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="LƯU THAY ĐỔI"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SCROLLABLE FORM BODY -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomActionBar"
        android:layout_below="@id/headerBlock"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/hud_space_md"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- FIELD 1: CURRENT PASSWORD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="MẬT KHẨU HIỆN TẠI"
                android:textColor="@color/hud_text_dim"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_current_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                app:boxBackgroundColor="@color/hud_surface_card"
                app:boxCornerRadiusBottomEnd="2dp"
                app:boxCornerRadiusBottomStart="2dp"
                app:boxCornerRadiusTopEnd="2dp"
                app:boxCornerRadiusTopStart="2dp"
                app:boxStrokeColor="@color/kinetic_orange"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/hud_text_dim"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_current_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:hint="Nhập mật khẩu đang dùng"
                    android:inputType="textPassword"
                    android:textColor="@color/hud_text_primary"
                    android:textColorHint="@color/hud_text_dim"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/btnForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:text="Quên mật khẩu?"
                android:textColor="@color/hud_primary"
                android:textSize="11sp" />

            <!-- FIELD 2: NEW PASSWORD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="MẬT KHẨU MỚI"
                android:textColor="@color/hud_text_dim"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_new_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                app:boxBackgroundColor="@color/hud_surface_card"
                app:boxCornerRadiusBottomEnd="2dp"
                app:boxCornerRadiusBottomStart="2dp"
                app:boxCornerRadiusTopEnd="2dp"
                app:boxCornerRadiusTopStart="2dp"
                app:boxStrokeColor="@color/kinetic_orange"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/hud_text_dim"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_new_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:hint="Tối thiểu 8 ký tự"
                    android:inputType="textPassword"
                    android:textColor="@color/hud_text_primary"
                    android:textColorHint="@color/hud_text_dim"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- FIELD 3: CONFIRM NEW PASSWORD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="XÁC NHẬN MẬT KHẨU MỚI"
                android:textColor="@color/hud_text_dim"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                app:boxBackgroundColor="@color/hud_surface_card"
                app:boxCornerRadiusBottomEnd="2dp"
                app:boxCornerRadiusBottomStart="2dp"
                app:boxCornerRadiusTopEnd="2dp"
                app:boxCornerRadiusTopStart="2dp"
                app:boxStrokeColor="@color/kinetic_orange"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/hud_text_dim"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:hint="Nhập lại mật khẩu mới"
                    android:inputType="textPassword"
                    android:textColor="@color/hud_text_primary"
                    android:textColorHint="@color/hud_text_dim"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SECURITY CRITERIA CHECKLIST CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_notif_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="■ TIÊU CHUẨN ĐỘ MẠNH MẬT KHẨU"
                    android:textColor="@color/hud_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Requirement 1: Length >= 8 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_req_length_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="○"
                        android:textColor="@color/hud_text_dim"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_req_length"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif"
                        android:text="Độ dài tối thiểu 8 ký tự"
                        android:textColor="@color/hud_text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Requirement 2: Uppercase & Lowercase -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_req_case_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="○"
                        android:textColor="@color/hud_text_dim"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_req_case"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif"
                        android:text="Bao gồm cả chữ hoa và chữ thường"
                        android:textColor="@color/hud_text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Requirement 3: Number or special char -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_req_special_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="○"
                        android:textColor="@color/hud_text_dim"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_req_special"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif"
                        android:text="Chứa ít nhất 1 chữ số hoặc ký tự đặc biệt"
                        android:textColor="@color/hud_text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
