<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#1A1D20"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeColor="#262B30"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Avatar / Icon -->
        <FrameLayout
            android:id="@+id/frame_search_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_search_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Avatar"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleAvatar"
                tools:src="@drawable/ic_person_chat" />

            <ImageView
                android:id="@+id/iv_search_group_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_chat_avatar_group"
                android:contentDescription="CLB Icon"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_group_chat"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Name & Subtitle -->
        <TextView
            android:id="@+id/tv_search_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btn_search_action"
            app:layout_constraintStart_toEndOf="@+id/frame_search_avatar"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Đức Huy" />

        <TextView
            android:id="@+id/tv_search_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8E8E93"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_search_action"
            app:layout_constraintStart_toEndOf="@+id/frame_search_avatar"
            app:layout_constraintTop_toBottomOf="@+id/tv_search_name"
            tools:text="128 KM tháng này • Hà Nội" />

        <!-- Action Button (Kết bạn / Tham gia) -->
        <TextView
            android:id="@+id/btn_search_action"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_search_btn_action"
            android:gravity="center"
            android:minWidth="80dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#121212"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Kết bạn" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
