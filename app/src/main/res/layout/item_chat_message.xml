<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_chat_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#1A1D20"
    app:cardCornerRadius="6dp"
    app:cardElevation="0dp"
    app:strokeColor="#24282D"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Avatar Container with Online Indicator -->
        <FrameLayout
            android:id="@+id/frame_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Avatar"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                tools:src="@drawable/ic_person_chat" />

            <!-- Group Avatar Overlay view (for group chats) -->
            <ImageView
                android:id="@+id/iv_group_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_chat_avatar_group"
                android:contentDescription="Group Icon"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_group_chat"
                android:visibility="gone"
                tools:visibility="gone" />

            <!-- Online Indicator Dot -->
            <View
                android:id="@+id/view_online_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_chat_online_dot" />

        </FrameLayout>

        <!-- Sender / Group Name -->
        <TextView
            android:id="@+id/tv_chat_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_chat_time"
            app:layout_constraintStart_toEndOf="@+id/frame_avatar"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Đức Huy" />

        <!-- Time Stamp -->
        <TextView
            android:id="@+id/tv_chat_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF5722"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_chat_name"
            tools:text="09:12" />

        <!-- Last Message -->
        <TextView
            android:id="@+id/tv_last_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8E8E93"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_unread_badge"
            app:layout_constraintStart_toEndOf="@+id/frame_avatar"
            app:layout_constraintTop_toBottomOf="@+id/tv_chat_name"
            tools:text="Mình đang ở Hồ Tây, tham gia nhé?" />

        <!-- Unread Badge -->
        <TextView
            android:id="@+id/tv_unread_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_unread_badge"
            android:gravity="center"
            android:minWidth="18dp"
            android:minHeight="18dp"
            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="5dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/tv_last_message"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_last_message"
            tools:text="2" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
