<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout_tracking"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".AuthSuccessActivity">

    <!-- LAYER 1: Full Screen Map Container (BEHIND EVERYTHING) -->
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_map_bg_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Map background"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_map_placeholder" />
    </FrameLayout>

    <!-- LAYER 2: Top Scrim Overlay for Contrast -->
    <View
        android:id="@+id/view_top_bar_scrim"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_top_scrim"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Navigation Bar Floating over Map -->
    <RelativeLayout
        android:id="@+id/layout_top_bar_tracking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back_tracking"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge_dark"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/dot_orange"
                android:drawablePadding="6dp"
                android:fontFamily="monospace"
                android:text="LIVE TELEMETRY"
                android:textColor="@color/kinetic_orange"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="monospace"
                android:text="TRACKING"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_profile_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Profile"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_nav_profile"
            app:shapeAppearanceOverlay="@style/CircleAvatar" />
    </RelativeLayout>

    <!-- Top Badges Floating Over Map -->
    <TextView
        android:id="@+id/badge_gps_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_badge_dark"
        android:drawableStart="@drawable/dot_green"
        android:drawableEnd="@drawable/ic_signal_bars"
        android:drawablePadding="6dp"
        android:fontFamily="monospace"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="GPS TÍN HIỆU MẠNH"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_top_bar_tracking" />

    <TextView
        android:id="@+id/badge_outdoor_run"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_badge_orange"
        android:drawableStart="@drawable/ic_shoes"
        android:drawablePadding="6dp"
        android:fontFamily="monospace"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:text="OUTDOOR RUN"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_top_bar_tracking" />

    <!-- Left Side: Cadence SPM Vertical Slider -->
    <LinearLayout
        android:id="@+id/container_spm_slider"
        android:layout_width="36dp"
        android:layout_height="160dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_spm_slider"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toTopOf="@+id/card_bottom_dashboard"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="SPM"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_spm"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:layout_marginVertical="8dp"
            android:layout_weight="1"
            android:max="200"
            android:progress="172"
            android:progressDrawable="@drawable/bg_gradient_progress" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="172"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right Side: Zoom Controls & GPS Art Pill Button -->
    <LinearLayout
        android:id="@+id/layout_map_zoom_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/btn_gps_art"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btn_map_location"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_badge_dark"
            android:contentDescription="Location"
            android:padding="8dp"
            android:src="@drawable/ic_target" />

        <ImageView
            android:id="@+id/btn_map_zoom_in"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_dark"
            android:contentDescription="Zoom in"
            android:padding="8dp"
            android:src="@drawable/ic_zoom_in" />

        <ImageView
            android:id="@+id/btn_map_zoom_out"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_dark"
            android:contentDescription="Zoom out"
            android:padding="8dp"
            android:src="@drawable/ic_zoom_out" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_gps_art"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_badge_orange"
        android:drawableStart="@drawable/ic_pencil"
        android:drawablePadding="6dp"
        android:fontFamily="monospace"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="GPS ART"
        android:textColor="@color/tab_active_text"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/card_bottom_dashboard"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- LAYER 3: FOREGROUND BOTTOM DASHBOARD -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_dashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_card"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_dashboard"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Drag Handle -->
            <View
                android:id="@+id/view_drag_handle"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@color/surface_border" />

            <!-- Primary Metric: Distance -->
            <TextView
                android:id="@+id/tv_distance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:drawableStart="@drawable/dot_cyan"
                android:drawablePadding="6dp"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:text="QUÃNG ĐƯỜNG"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_distance_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="5.42"
                    android:textColor="@color/text_primary"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_distance_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:text="KM"
                    android:textColor="@color/kinetic_orange"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3-Column Stats Grid -->
            <LinearLayout
                android:id="@+id/layout_stats_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Box 1: Duration -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface_card_sub"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_clock"
                            android:drawablePadding="4dp"
                            android:fontFamily="monospace"
                            android:text="THỜI GIAN"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_duration_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="monospace"
                            android:text="28:47"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="ELAPSED"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Box 2: Pace -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface_card_sub"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_compass"
                            android:drawablePadding="4dp"
                            android:fontFamily="monospace"
                            android:text="PACE TB"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_pace_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="monospace"
                            android:text="5'18&quot;"
                            android:textColor="@color/kinetic_orange"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="/KM TARGET"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Box 3: Heart Rate -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface_card_sub"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_pink_heart"
                            android:drawablePadding="4dp"
                            android:fontFamily="monospace"
                            android:text="NHỊP TIM"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tv_hr_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="monospace"
                            android:text="156"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="BPM (ZONE 4)"
                            android:textColor="#FF5252"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Lap Prediction Row -->
            <RelativeLayout
                android:id="@+id/layout_lap_prediction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_sub_card"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/badge_lap_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_badge_dark"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="LAP 06"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_lap_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@+id/badge_lap_number"
                    android:text="Km 5-6 Pace Dự Kiến:"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_predicted_pace_diff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="monospace"
                    android:text="5'12&quot; (-0'06&quot;)"
                    android:textColor="@color/neon_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Bottom Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Hold / Stop Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_hold_stop"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@color/surface_card_sub"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Stop"
                            android:src="@drawable/ic_stop" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:text="GIỮ"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pause Run Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pause_run"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/kinetic_orange"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="TẠM DỪNG"
                    android:textColor="@color/bg_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_pause"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="@color/bg_dark" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
