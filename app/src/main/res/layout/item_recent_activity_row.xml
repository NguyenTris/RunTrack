<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_recent_activity_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Date Badge Box -->
        <LinearLayout
            android:id="@+id/box_date_badge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_sub_card"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_activity_day_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/kinetic_orange"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="T4" />

            <TextView
                android:id="@+id/tv_activity_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="9sp"
                tools:text="21/10" />
        </LinearLayout>

        <!-- Activity Name & Stats -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toStartOf="@+id/layout_distance_right"
            android:layout_toEndOf="@+id/box_date_badge"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_activity_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Chạy sáng - Hồ Gươm" />

            <TextView
                android:id="@+id/tv_activity_metrics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="28:47 · 5'18&quot;/KM" />
        </LinearLayout>

        <!-- Distance Right Column -->
        <LinearLayout
            android:id="@+id/layout_distance_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_activity_distance_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="5.42" />

            <TextView
                android:id="@+id/tv_activity_distance_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/kinetic_orange"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="KM" />
        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
