<?xml version="1.0" encoding="utf-8"?>
<!-- [SCR-03] CẤU HÌNH MỤC TIÊU TẬP LUYỆN (TARGET GOALS CALIBRATION) -->
<!-- Architecture: RelativeLayout (Root) + ScrollView > LinearLayout (Body) + LinearLayout (Steppers) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_canvas">

    <!-- PRE-HEADER STRIP -->
    <LinearLayout
        android:id="@+id/telemetryStrip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hud_telemetry_strip_height"
        android:layout_alignParentTop="true"
        android:background="@color/hud_surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hud_space_md"
        android:paddingEnd="@dimen/hud_space_md">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="CALIBRATION // TARGET GOALS"
            android:textColor="@color/hud_text_dim"
            android:textSize="@dimen/hud_text_telemetry_strip" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="WEEKLY TRACKING ACTIVE"
            android:textColor="@color/hud_primary"
            android:textSize="@dimen/hud_text_telemetry_strip" />
    </LinearLayout>

    <!-- TOP APP BAR -->
    <RelativeLayout
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hud_top_bar_height"
        android:layout_below="@id/telemetryStrip"
        android:background="@color/hud_surface"
        android:paddingStart="@dimen/hud_space_md"
        android:paddingEnd="@dimen/hud_space_md">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:text="&lt; HUB"
            android:textColor="@color/hud_primary"
            android:textSize="@dimen/hud_text_body"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:letterSpacing="0.1"
            android:text="MỤC TIÊU TẬP LUYỆN"
            android:textAllCaps="true"
            android:textColor="@color/hud_text_primary"
            android:textSize="@dimen/hud_text_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/hud_badge_cyan"
            android:fontFamily="monospace"
            android:paddingStart="@dimen/hud_space_xs"
            android:paddingTop="@dimen/hud_space_2xs"
            android:paddingEnd="@dimen/hud_space_xs"
            android:paddingBottom="@dimen/hud_space_2xs"
            android:text="GOALS"
            android:textColor="@color/hud_primary"
            android:textSize="@dimen/hud_text_badge" />
    </RelativeLayout>

    <!-- FIXED BOTTOM ACTION BUTTON -->
    <Button
        android:id="@+id/btnApplyGoals"
        style="@style/HudButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hud_btn_primary_height"
        android:layout_alignParentBottom="true"
        android:layout_margin="@dimen/hud_space_md"
        android:text="ÁP DỤNG MỤC TIÊU MỚI" />

    <!-- SCROLLABLE BODY -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnApplyGoals"
        android:layout_below="@id/topAppBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/hud_space_md">

            <!-- WEEKLY PROGRESS CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hud_space_lg"
                android:background="@drawable/hud_card_container"
                android:orientation="vertical"
                android:padding="@dimen/hud_space_md">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:fontFamily="monospace"
                        android:text="TIẾN ĐỘ TUẦN NÀY (WEEK 42)"
                        android:textColor="@color/hud_text_dim"
                        android:textSize="@dimen/hud_text_caption" />

                    <TextView
                        android:id="@+id/tvCurrentProgressFraction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="monospace"
                        android:text="34.5 / 50.0 KM"
                        android:textColor="@color/hud_primary"
                        android:textSize="@dimen/hud_text_caption"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Big Percent Readout -->
                <TextView
                    android:id="@+id/tvProgressPercent"
                    style="@style/HudText.DisplayHero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hud_space_xs"
                    android:text="69.0 %" />

                <!-- Mechanical Solid Progress Bar -->
                <ProgressBar
                    android:id="@+id/progressBarGoals"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="@dimen/hud_space_sm"
                    android:max="100"
                    android:progress="69"
                    android:progressTint="@color/hud_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hud_space_sm"
                    android:fontFamily="monospace"
                    android:text="Còn 15.5 km để hoàn thành mục tiêu. Thời hạn: 3 ngày."
                    android:textColor="@color/hud_text_sub"
                    android:textSize="@dimen/hud_text_caption" />
            </LinearLayout>

            <TextView
                style="@style/HudText.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hud_space_sm"
                android:text="■ TINH CHỈNH MỤC TIÊU TUẦN" />

            <!-- STEPPER 1: DISTANCE (KM) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hud_space_md"
                android:background="@drawable/hud_card_container"
                android:orientation="vertical"
                android:padding="@dimen/hud_space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="TỔNG QUÃNG ĐƯỜNG TUẦN (KM)"
                    android:textColor="@color/hud_text_dim"
                    android:textSize="@dimen/hud_text_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/hud_space_sm"
                    android:background="@color/hud_surface_sub"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMinusDistance"
                        style="@style/HudButton.Outline"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:text="-"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvTargetDistanceVal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="50.0 KM"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPlusDistance"
                        style="@style/HudButton.Outline"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:text="+"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- STEPPER 2: DURATION (HOURS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hud_space_md"
                android:background="@drawable/hud_card_container"
                android:orientation="vertical"
                android:padding="@dimen/hud_space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="TỔNG THỜI GIAN VẬN ĐỘNG (HOURS)"
                    android:textColor="@color/hud_text_dim"
                    android:textSize="@dimen/hud_text_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/hud_space_sm"
                    android:background="@color/hud_surface_sub"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMinusHours"
                        style="@style/HudButton.Outline"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:text="-"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvTargetHoursVal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="5.0 GIỜ"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPlusHours"
                        style="@style/HudButton.Outline"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:text="+"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- STEPPER 3: CALORIES (KCAL) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/hud_space_md"
                android:background="@drawable/hud_card_container"
                android:orientation="vertical"
                android:padding="@dimen/hud_space_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="TIÊU HAO NĂNG LƯỢNG MỤC TIÊU (KCAL)"
                    android:textColor="@color/hud_text_dim"
                    android:textSize="@dimen/hud_text_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/hud_space_sm"
                    android:background="@color/hud_surface_sub"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMinusCalories"
                        style="@style/HudButton.Outline"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:text="-"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvTargetCaloriesVal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:text="3,200 KCAL"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPlusCalories"
                        style="@style/HudButton.Outline"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:text="+"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
