<?xml version="1.0" encoding="utf-8"?>
<!-- [SCR-HELP-01] TRUNG TÂM TRỢ GIÚP & HỎI ĐÁP (HELP CENTER & FAQ) -->
<!-- Aerospace Kinetic HUD Architecture -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_canvas">

    <!-- PRE-HEADER TELEMETRY STRIP (Fixed Top) -->
    <LinearLayout
        android:id="@+id/telemetryStrip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hud_telemetry_strip_height"
        android:layout_alignParentTop="true"
        android:background="@color/hud_surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hud_space_md"
        android:paddingEnd="@dimen/hud_space_md">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:text="&lt; CÀI ĐẶT"
            android:textColor="@color/hud_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="RT / HELP-01"
            android:textColor="@color/hud_text_dim"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- HEADER BLOCK -->
    <LinearLayout
        android:id="@+id/headerBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/telemetryStrip"
        android:background="@color/hud_surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/hud_space_md"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Trung tâm trợ giúp"
            android:textColor="@color/hud_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Giải đáp thắc mắc kỹ thuật, cấu hình cảm biến và kênh hỗ trợ 24/7."
            android:textColor="@color/hud_text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- SCROLLABLE BODY CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerBlock"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/hud_space_md"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- SEARCH BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_notif_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="🔍"
                    android:textColor="@color/hud_primary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etSearchFaq"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:fontFamily="sans-serif"
                    android:hint="Tìm câu hỏi hoặc từ khóa trợ giúp..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="@color/hud_text_primary"
                    android:textColorHint="@color/hud_text_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- SECTION 1: FAQ RECYCLER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="■ CÂU HỎI THƯỜNG GẶP (FREQUENTLY ASKED)"
                android:textColor="@color/hud_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFaqList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- SECTION 2: DIRECT SUPPORT CONTACT CHANNELS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="■ KÊNH HỖ TRỢ TRỰC TIẾP (DIRECT CHANNELS)"
                android:textColor="@color/hud_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- CHANNEL 1: EMAIL SUPPORT -->
            <RelativeLayout
                android:id="@+id/btnEmailSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_notif_card"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp">

                <TextView
                    android:id="@+id/icEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="monospace"
                    android:text="✉"
                    android:textColor="@color/kinetic_orange"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@+id/icEmail"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Email Hỗ Trợ Kỹ Thuật"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="support@runtrack.app — Phản hồi trong 2h"
                        android:textColor="@color/hud_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- CHANNEL 2: HOTLINE SUPPORT -->
            <RelativeLayout
                android:id="@+id/btnCallSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_notif_card"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp">

                <TextView
                    android:id="@+id/icPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="monospace"
                    android:text="📞"
                    android:textColor="@color/hud_signal"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@+id/icPhone"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Tổng Đài Trợ Giúp Runner"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="1900 6868 (07:00 - 22:00 hàng ngày)"
                        android:textColor="@color/hud_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- CHANNEL 3: BUG REPORT -->
            <RelativeLayout
                android:id="@+id/btnReportBug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_notif_card"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp">

                <TextView
                    android:id="@+id/icBug"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="monospace"
                    android:text="⚡"
                    android:textColor="@color/hud_primary"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@+id/icBug"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Báo Cáo Lỗi Kỹ Thuật &amp; Telemetry"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:text="Gửi log nhật ký hệ thống kèm tọa độ GPS lỗi"
                        android:textColor="@color/hud_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
