<?xml version="1.0" encoding="utf-8"?>
<!-- [SCR-THEME-01] CHỦ ĐỀ & GIAO DIỆN HUD (THEME & HUD PALETTES) -->
<!-- Aerospace Kinetic HUD Architecture -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_canvas">

    <!-- PRE-HEADER TELEMETRY STRIP (Fixed Top) -->
    <LinearLayout
        android:id="@+id/telemetryStrip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hud_telemetry_strip_height"
        android:layout_alignParentTop="true"
        android:background="@color/hud_surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hud_space_md"
        android:paddingEnd="@dimen/hud_space_md">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:text="&lt; CÀI ĐẶT"
            android:textColor="@color/hud_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="RT / THEME-01"
            android:textColor="@color/hud_text_dim"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- HEADER BLOCK -->
    <LinearLayout
        android:id="@+id/headerBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/telemetryStrip"
        android:background="@color/hud_surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/hud_space_md"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Chủ đề &amp; Giao diện HUD"
            android:textColor="@color/hud_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Tùy biến bảng màu sắc, độ tương phản hiển thị và tiết kiệm pin OLED."
            android:textColor="@color/hud_text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- FIXED BOTTOM SAVE BUTTON -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/hud_surface_dark"
        android:gravity="center"
        android:paddingHorizontal="@dimen/hud_space_md">

        <TextView
            android:id="@+id/btnSaveThemeSettings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/hud_bg_bar_orange"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="LƯU CHỦ ĐỀ GIAO DIỆN"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SCROLLABLE BODY CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomActionBar"
        android:layout_below="@id/headerBlock"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/hud_space_md"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- SECTION 1: THEME PALETTES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="■ BẢNG MÀU CHỦ ĐỀ (COLOR PALETTES)"
                android:textColor="@color/hud_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- OPTION 1: AEROSPACE DARK (DEFAULT) -->
            <RelativeLayout
                android:id="@+id/card_theme_aerospace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_notif_card"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp">

                <TextView
                    android:id="@+id/radio_aerospace_indicator"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="@color/kinetic_orange"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@+id/radio_aerospace_indicator"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="AEROSPACE DARK (KINETIC HUD)"
                            android:textColor="@color/hud_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_orange"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="6dp"
                            android:text="MẶC ĐỊNH"
                            android:textColor="@color/white"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif"
                        android:text="Nền đen #121212 kết hợp chỉ số cam Kinetic phản quang cao độ và font chữ kỹ thuật hàng không."
                        android:textColor="@color/hud_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- OPTION 2: AMOLED PURE BLACK -->
            <RelativeLayout
                android:id="@+id/card_theme_amoled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_notif_card"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp">

                <TextView
                    android:id="@+id/radio_amoled_indicator"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="@color/hud_text_dim"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@+id/radio_amoled_indicator"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="AMOLED PURE BLACK (TIẾT KIỆM PIN)"
                            android:textColor="@color/hud_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_badge_dark"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="6dp"
                            android:text="OLED 0W"
                            android:textColor="@color/hud_signal"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif"
                        android:text="Đen sâu tuyệt đối #000000, tắt hoàn toàn điểm ảnh màn hình OLED giúp tối đa hóa thời lượng pin khi chạy Marathon."
                        android:textColor="@color/hud_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- OPTION 3: CYAN STEALTH -->
            <RelativeLayout
                android:id="@+id/card_theme_cyan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_notif_card"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp">

                <TextView
                    android:id="@+id/radio_cyan_indicator"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="@color/hud_text_dim"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@+id/radio_cyan_indicator"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="CYAN STEALTH (CYBERPUNK)"
                            android:textColor="@color/hud_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/hud_badge_cyan"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="6dp"
                            android:text="ELECTRIC"
                            android:textColor="@color/hud_primary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif"
                        android:text="Điểm nhấn ánh sáng xanh Electric Cyan (#00E5FF). Phong cách công nghệ viễn tưởng hiện đại."
                        android:textColor="@color/hud_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- OPTION 4: SOLAR LIGHT -->
            <RelativeLayout
                android:id="@+id/card_theme_solar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_notif_card"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp">

                <TextView
                    android:id="@+id/radio_solar_indicator"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="@color/hud_text_dim"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@+id/radio_solar_indicator"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="SOLAR LIGHT (CHẾ ĐỘ BAN NGÀY)"
                            android:textColor="@color/hud_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif"
                        android:text="Tông màu trắng xám sáng tương phản cao, dễ nhìn khi chạy bộ dưới ánh nắng mặt trời buổi trưa."
                        android:textColor="@color/hud_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- SECTION 2: ADAPTIVE DISPLAY & ACCESSIBILITY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="■ TÙY CHỈNH THÍCH ỨNG &amp; TRỢ NĂNG"
                android:textColor="@color/hud_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- TOGGLE 1: AUTO SWITCH SUNSET -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_notif_card"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Tự động chuyển chế độ theo mặt trời lặn"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif"
                        android:text="Bật Dark mode khi hoàng hôn buông xuống và chuyển sang Light mode khi bình minh."
                        android:textColor="@color/hud_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_auto_sunset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:checked="true" />
            </LinearLayout>

            <!-- TOGGLE 2: HIGH CONTRAST NEON -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_notif_card"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Tăng cường tương phản rực rỡ (High Contrast Neon)"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif"
                        android:text="Tăng độ rực màu của vạch polyline và nhịp tim để đọc nhanh trong 0.2s liếc nhìn."
                        android:textColor="@color/hud_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_high_contrast_neon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:checked="true" />
            </LinearLayout>

            <!-- TOGGLE 3: REDUCE MOTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_notif_card"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Giảm chuyển động &amp; nhấp nháy (Reduce Motion)"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif"
                        android:text="Tắt các hiệu ứng xung nhịp tim đập và tia quét radar telemetry để chống mỏi mắt."
                        android:textColor="@color/hud_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_reduce_motion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:checked="false" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
