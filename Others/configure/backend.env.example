# =====================================================================
# RunTrack Backend & Web Admin - Cấu hình biến môi trường mẫu
# Sao chép file này thành `.env` rồi điều chỉnh theo môi trường thực tế.
# Không commit file `.env` chứa khóa bí mật thật lên Git.
# =====================================================================

# --- 1. Cơ sở dữ liệu PostgreSQL (dùng cho Docker Compose / Production) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=runtrack_db
DB_USER=runtrack_admin
DB_PASSWORD=RunTrackSecure2026

# Chuỗi kết nối đầy đủ (ưu tiên cao hơn DB_* nếu được khai báo).
# Khi chạy local nhanh không cần PostgreSQL, bỏ dấu # ở dòng dưới để dùng SQLite:
# DATABASE_URL=sqlite:///./runtrack_local.db

# --- 2. Bảo mật JWT ---
# Khóa bí mật ký JSON Web Token (nên đổi thành chuỗi ngẫu nhiên dài trên production)
SECRET_KEY=runtrack_super_secret_jwt_key_2026

# --- 3. Dịch vụ bên ngoài ---
# API Key của OpenWeatherMap dùng cho endpoint GET /weather (để trống nếu chưa đăng ký)
OPENWEATHER_API_KEY=

# --- 4. CORS & Khởi tạo dữ liệu mẫu ---
# Danh sách origin được phép gọi API, phân tách bởi dấu phẩy (ví dụ: http://localhost:3000,http://localhost:5173) hoặc * cho môi trường demo
CORS_ORIGINS=*

# Bật tự động nạp dữ liệu mẫu (Admin, 3 runner, 3 CLB, 7 buổi chạy) khi khởi động Backend (true / false)
AUTO_SEED_DEMO=true

# --- 5. Frontend Web Admin (Docker Compose build arg) ---
# Địa chỉ Backend API mà Web Admin sẽ kết nối tới
VITE_API_BASE_URL=http://localhost:8000
